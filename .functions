# ~/.functions - Bare dotfiles CLI
# Source this file in your shell: source ~/.functions

# ---------------------------------------------------------------------------
# Configuration (override by exporting before sourcing)
# ---------------------------------------------------------------------------
: "${MISE_VERSION:=}"                                  # empty = use installer default (latest stable)
: "${MISE_INSTALL_PATH:=$HOME/.local/bin/mise}"
: "${DOTFILES_GIT_DIR:=$HOME/.cfg}"

_BARE_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"

# ---------------------------------------------------------------------------
# Helpers (prefixed _bare_ to avoid namespace pollution)
# ---------------------------------------------------------------------------

_bare_log() {
  printf '\n==> %s\n' "$*"
}

_bare_have() {
  command -v "$1" >/dev/null 2>&1
}

_bare_ensure_line() {
  local file="$1"
  local line="$2"
  touch "$file"
  grep -Fqx "$line" "$file" || printf '%s\n' "$line" >>"$file"
}

_bare_portable_sed_i() {
  if [[ "$_BARE_OS" == "darwin" ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

# ---------------------------------------------------------------------------
# Dependency installation functions
# ---------------------------------------------------------------------------

_bare_install_base_packages_linux() {
  sudo apt-get update
  sudo apt-get install -y \
    bison \
    build-essential \
    ca-certificates \
    curl \
    git \
    gpg \
    libevent-dev \
    libncurses-dev \
    libncurses5-dev \
    pkg-config \
    unzip \
    zsh
}

_bare_install_base_packages_darwin() {
  if ! _bare_have brew; then
    _bare_log "Installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
  brew install git gnupg unzip zsh libevent ncurses pkg-config utf8proc
}

_bare_install_base_packages() {
  _bare_log "Installing base packages"
  case "$_BARE_OS" in
    linux)  _bare_install_base_packages_linux ;;
    darwin) _bare_install_base_packages_darwin ;;
    *)      echo "ERROR: unsupported OS: $_BARE_OS" >&2; return 1 ;;
  esac
}

_bare_install_oh_my_zsh() {
  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    _bare_log "Oh My Zsh already installed"
    return
  fi

  _bare_log "Installing Oh My Zsh without overwriting ~/.zshrc"
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" \
    --unattended --keep-zshrc
}

_bare_install_mise_binary() {
  local want_version="${MISE_VERSION:-}"
  local have_version=""

  if [[ -x "$MISE_INSTALL_PATH" ]]; then
    have_version="$("$MISE_INSTALL_PATH" --version 2>/dev/null | head -n1 | awk '{print $1}')"
  elif _bare_have mise; then
    have_version="$(mise --version 2>/dev/null | head -n1 | awk '{print $1}')"
  fi

  if [[ -n "$have_version" ]]; then
    if [[ -z "$want_version" || "$have_version" == "$want_version" ]]; then
      _bare_log "mise ${have_version} already installed"
      return
    fi
    _bare_log "mise present but version is ${have_version}; installing ${want_version}"
  else
    _bare_log "Installing mise ${want_version:-latest}"
  fi

  # The official installer (https://mise.run) detects OS/arch itself, installs
  # to MISE_INSTALL_PATH, and is idempotent (skips when already at the wanted
  # version). MISE_VERSION pins a release; empty = installer's default (latest).
  mkdir -p "$(dirname "$MISE_INSTALL_PATH")"
  if [[ -n "$want_version" ]]; then
    curl -fsSL https://mise.run \
      | MISE_VERSION="$want_version" MISE_INSTALL_PATH="$MISE_INSTALL_PATH" sh
  else
    curl -fsSL https://mise.run | MISE_INSTALL_PATH="$MISE_INSTALL_PATH" sh
  fi
}

_bare_ensure_zshrc_mise_block() {
  local zshrc="$HOME/.zshrc"
  _bare_log "Ensuring ~/.zshrc contains mise activation"

  # Drop legacy asdf setup lines left over from the previous asdf-based setup
  _bare_portable_sed_i '/asdf\.sh/d' "$zshrc"
  _bare_portable_sed_i '/completions\/asdf\.bash/d' "$zshrc"
  # Drop absolute/path-based mise activate lines so we can normalize them below
  _bare_portable_sed_i '/\.local\/bin\/mise activate/d' "$zshrc"

  # Remove the stale ASDF_DATA_DIR export written to ~/.exports by older setups
  if [[ -f "$HOME/.exports" ]]; then
    _bare_portable_sed_i '/export ASDF_DATA_DIR=/d' "$HOME/.exports"
  fi

  _bare_ensure_line "$zshrc" 'command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"'
}

_bare_ensure_zshrc_ohmyzsh_block() {
  local file="$HOME/.zshrc"
  _bare_log "Ensuring ~/.zshrc contains Oh My Zsh bootstrap"

  _bare_ensure_line "$file" 'export ZSH="$HOME/.oh-my-zsh"'

  if ! grep -Eq '^ZSH_THEME=' "$file"; then
    printf '%s\n' 'ZSH_THEME="robbyrussell"' >>"$file"
  fi

  if ! grep -Eq '^plugins=\(' "$file"; then
    printf '%s\n' 'plugins=(dotenv git kubectl tmux vi-mode)' >>"$file"
  fi

  _bare_ensure_line "$file" 'source "$ZSH/oh-my-zsh.sh"'
}

_bare_ensure_config_alias() {
  _bare_log "Ensuring config alias is present in ~/.aliases"
  _bare_ensure_line "$HOME/.aliases" "alias config='git --git-dir=\$HOME/.cfg/ --work-tree=\$HOME'"
}

_bare_set_zsh_as_login_shell() {
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [[ "${SHELL:-}" == "$zsh_path" ]]; then
    _bare_log "Login shell already set to zsh"
    return
  fi

  _bare_log "Setting login shell to zsh"
  if [[ "$_BARE_OS" == "darwin" ]] && ! grep -Fxq "$zsh_path" /etc/shells; then
    _bare_log "Adding $zsh_path to /etc/shells"
    echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  fi
  chsh -s "$zsh_path" || true
}

_bare_source_mise_env() {
  export PATH="$HOME/.local/bin:$PATH"
  if [[ "$_BARE_OS" == "darwin" && -d /opt/homebrew/bin ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
  fi
}

_bare_install_from_tool_versions() {
  if [[ ! -f "$HOME/.tool-versions" ]]; then
    echo "ERROR: ~/.tool-versions not found after dotfiles checkout" >&2
    return 1
  fi

  _bare_source_mise_env

  if ! _bare_have mise; then
    echo "ERROR: mise not found on PATH after installation" >&2
    return 1
  fi

  _bare_log "Installing tool versions from ~/.tool-versions via mise"
  (
    cd "$HOME"
    mise install
  )

  _bare_log "Current mise tools"
  (
    cd "$HOME"
    mise ls 2>/dev/null || true
  )
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

_bare_update() {
  (
    set -euo pipefail

    _bare_install_base_packages
    _bare_install_oh_my_zsh
    _bare_install_mise_binary
    _bare_ensure_zshrc_mise_block
    _bare_ensure_zshrc_ohmyzsh_block
    _bare_ensure_config_alias
    _bare_set_zsh_as_login_shell
    _bare_install_from_tool_versions

    _bare_log "Update complete"
    echo "Open a new shell or run: exec zsh"
  )
}

_bare_status() {
  echo "Dotfiles bare repo: $DOTFILES_GIT_DIR"
  if [[ -d "$DOTFILES_GIT_DIR" ]]; then
    echo "  Repo:        present"
  else
    echo "  Repo:        NOT FOUND"
  fi
  echo "  Oh My Zsh:   $([[ -d "$HOME/.oh-my-zsh" ]] && echo "installed" || echo "not installed")"
  echo "  mise:        $(_bare_have mise && mise --version 2>/dev/null | head -n1 | awk '{print $1}' || echo "not installed")"
  echo "  zsh:         $(_bare_have zsh && command -v zsh || echo "not installed")"
  echo "  Login shell: ${SHELL:-unknown}"
  if [[ -f "$HOME/.tool-versions" ]]; then
    echo "  Tool versions:"
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "$line" ]] && continue
      echo "    $line"
    done < "$HOME/.tool-versions"
  fi
}

_bare_help() {
  cat <<'HELP'
bare - CLI for the bare dotfiles system

Usage: bare <command>

Commands:
  update    Idempotently install/update all dependencies
  status    Show current state of dotfiles and tools
  help      Show this help message
HELP
}

# ---------------------------------------------------------------------------
# Main dispatcher
# ---------------------------------------------------------------------------

bare() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    update)         _bare_update "$@" ;;
    status)         _bare_status "$@" ;;
    help|--help|-h) _bare_help ;;
    *)
      echo "bare: unknown command '$cmd'" >&2
      _bare_help >&2
      return 1
      ;;
  esac
}
